{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "career-counselor-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 3日ごと（0時UTC）にSupabaseへアクセスして一時停止を防ぐ
  "triggers": {
    "crons": ["0 0 */3 * *"]
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
